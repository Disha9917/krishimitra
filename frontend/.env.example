# FasalDrishti frontend environment configuration.
# Copy to .env and adjust for your environment. Backend secrets NEVER belong here.

# Laravel backend API base URL.
# NOTE: this project's routes are registered under /v1 (no /api segment) —
# see backend/bootstrap/app.php (apiPrefix: 'v1') and `php artisan route:list`.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/v1
